# Copia este ficheiro para ".env" (na mesma pasta) e cola a chave.
# O .env NUNCA vai para o GitHub (está no .gitignore) — e não o mandes a ninguém.
SUPABASE_SERVICE_ROLE_KEY=cola-aqui-a-service-role-key
MOTOR=browser
MANUAL=true
# Quantos vinhos desta vez (vazio = o que está nas Definições da app):
LIMITE=18
# ENSAIO=true lê as páginas mas não grava nada:
ENSAIO=false
# O preço na Garrafeira Nacional e na Granvine (false para só o Vivino):
LOJAS=true
